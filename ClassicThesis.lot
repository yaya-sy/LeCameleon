\contentsline {table}{\numberline {2.1}{\ignorespaces Main efficiency metrics for LLM training and inference. Arrows indicate the optimization direction.}}{17}{table.caption.7}%
\contentsline {table}{\numberline {2.2}{\ignorespaces Model sizes prescribed by different scaling laws for a fixed training-data budget of $16.55$T tokens.}}{18}{table.caption.8}%
\contentsline {table}{\numberline {2.3}{\ignorespaces Vocabulary specialization in the seventh layer of OLMoE-1B-7B. Table adapted from \citep {muennighoff2025olmoe}.}}{35}{table.caption.23}%
\contentsline {table}{\numberline {2.4}{\ignorespaces Effect of \textit {n}-gram vocabulary scaling in Qwen3.8-Flash-Next. Vocabulary scales are measured relative to the base tokenizer vocabulary size. Larger vocabularies add parameters. Table adapted from \citep {qwen2026qwen38next}.}}{40}{table.caption.31}%
\ttl@tocsep 
\contentsline {table}{\numberline {3.1}{\ignorespaces Positioning of our approach within the compression literature. \textbf {No Custom Kernel} indicates that a custom GPU kernel is not required to observe speedup and \textbf {No Ampere-only} indicates that speedup is not restricted to Ampere GPUs. \textbf {Calib. Data} is the total number of tokens in billions used for compression.}}{48}{table.caption.35}%
\contentsline {table}{\numberline {3.2}{\ignorespaces Benchmarks and corresponding metrics that were used to evaluate the models.}}{58}{table.caption.48}%
\contentsline {table}{\numberline {3.3}{\ignorespaces \textbf {Zero-shot evaluation results} for the base non-compressed models (0\%), and the 20\%, 25\%, and 30\% compressed models.}}{59}{table.caption.53}%
\contentsline {table}{\numberline {3.4}{\ignorespaces \textbf {Compressed models save memory and speed up computation.} Inference speed was measured on a single A100 GPU, using the whole test split of Wikitext2 with a batch size of 4 and varying the sequence length from 512 to 16384 tokens. All the models were loaded in bf16 and used Flash-Attention2. OOM stands for out of memory.}}{60}{table.caption.54}%
\contentsline {table}{\numberline {3.5}{\ignorespaces \textbf {40\% compressed Phi-2 3B competes with models of similar size while being compressed using only 13M tokens.} We compress Phi-2 3B to 1.7B (by removing 40\% of the parameters) and compare its zero-shot performance to that of other recent language models of similar sizes.}}{60}{table.caption.55}%
\contentsline {table}{\numberline {3.6}{\ignorespaces \textbf {Compressed models recover well when fine-tuned.} Zero-shot performance of the base non-compressed models (0\%) and the 40\% compressed models, without and with fine-tuning (FT). Models were fine-tuned on the whole Slim-Orca dataset (191 million tokens).}}{61}{table.caption.56}%
\contentsline {table}{\numberline {3.7}{\ignorespaces \textbf {Mamba-based language models can be efficiently compressed}. Zero-shot evaluation results for the non-compressed (0\%) and for the compressed Mamba-based language models (20\%).}}{61}{table.caption.59}%
\contentsline {table}{\numberline {3.8}{\ignorespaces \textbf {Compressing Mamba models saves memory and speeds up computation.} Inference speed was measured on a single A100 GPU, using the whole test split of Wikitext2 with a batch size of 4 and by varying the sequence length from 512 to 16384 tokens. All models were loaded in bf16 and used Flash-Attention2.}}{61}{table.caption.60}%
\contentsline {table}{\numberline {3.9}{\ignorespaces \textbf {The 37\% compressed Whisper is faster and 1.46$\times $ lighter.} The WER is computed on the English test subset of the FLEURS dataset. The speed (tokens/second) corresponds to the transcription of 400 tokens from a dataset containing 2,048 speech examples, using a batch size of 128. A single A100 GPU is used and the model is loaded in FP32, without Flash-Attention. We also give the GPU Memory (VRAM) occupied by each model.}}{62}{table.caption.64}%
\contentsline {table}{\numberline {3.10}{\ignorespaces \textbf {The joint loss generally performs better}: Zero-shot performance of the three losses using the same setup for each model, as described in Section~\ref {sec:xp}.}}{63}{table.caption.68}%
\contentsline {table}{\numberline {3.11}{\ignorespaces Comparing the Wikitext perplexity convergence of the three losses for 2M training tokens.}}{65}{table.caption.69}%
\contentsline {table}{\numberline {3.12}{\ignorespaces Compression times for the three compression strategies at 20\% parameter reduction on a single A100 GPU. For the bottom-first and top-first compression strategies, we used the same hyperparameters as in Section~\ref {sec:xp}.}}{66}{table.caption.71}%
\contentsline {table}{\numberline {3.13}{\ignorespaces Average zero-shot performance for the three compression strategies at 20\% compression. For the bottom-first and top-first compression strategies, we used the same hyperparameters as in Section~\ref {sec:xp}.}}{66}{table.caption.73}%
\contentsline {table}{\numberline {3.14}{\ignorespaces \textbf {Comparison of our method with SliceGPT on zero-shot task evaluation for Phi-2 3B.} We give the evaluation scores before compression (0\%), both as reported by SliceGPT and as reproduced by us. Both methods use the Alpaca calibration dataset for compression.}}{67}{table.caption.74}%
\contentsline {table}{\numberline {3.15}{\ignorespaces Steve Jobs Story by the 20\% and 40\% compressed Phi-2 3B models, without \textit {any} fine-tuning. \textbf {Prompt: "Here the story of Steve Jobs:"}}}{68}{table.caption.75}%
\contentsline {table}{\numberline {3.16}{\ignorespaces The Civil War Story by the 20\% and 40\% compressed models, without \textit {any} fine-tuning. \textbf {Prompt: "What is the cause of the Civil War? Here is the story."}}}{69}{table.caption.76}%
\contentsline {table}{\numberline {3.17}{\ignorespaces Zero-shot performance on AfriMMLU for the 30\% compressed InkubaLM model for the Hausa language.}}{70}{table.caption.77}%
\ttl@tocsep 
\contentsline {table}{\numberline {4.1}{\ignorespaces \textbf {Main results.} Accuracy and efficiency after layer merging and head shearing (embedding decomposition). Speed is measured on a MacBook Air M1 while decoding 256 tokens for each utterance in a batch of 10. Bambara's less standardized orthography may partly explain the high absolute WER.}}{78}{table.caption.90}%
\contentsline {table}{\numberline {4.2}{\ignorespaces \textbf {Extreme head shearing of Gemma.} Scores are percentages (higher is better). We report normalized accuracy for HellaSwag, PIQA, and ARC-Challenge, and accuracy for BoolQ and WinoGrande.}}{81}{table.caption.100}%
